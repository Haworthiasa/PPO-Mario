__pycache__/
*.pyc
.venv/
*.egg-info/
.pytest_cache/
.claude/distill/
.claude/

# Kết quả huấn luyện: giữ config.yaml, progress.csv, evals.csv, biểu đồ và JSON đánh giá;
# bỏ checkpoint, video và nhật ký vì nặng.
checkpoints/
runs/**/videos/
runs/**/*.log
*.pt
*.mp4
# Ngoại lệ: hai video chấm của bản nộp (mỗi tệp khoảng 0,2 MB), README trỏ tới chúng.
!submission/*.mp4
*.bak

# Bản mã cũ trước khi chuyển sang kho mã của thầy
legacy/

# Dữ liệu thô từng bước của các script chẩn đoán (trace.npz, wall-obs.npz): nặng, tạo lại được bằng script.
*.npz
# Tệp ghi số tiến trình của lượt huấn luyện và tệp lỗi của công cụ dòng lệnh
*.pid
*.stackdump
